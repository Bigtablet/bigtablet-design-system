{
	"name": "@bigtablet/design-system",
	"version": "3.17.2",
	"description": "Bigtablet Design System UI Components",
	"type": "module",
	"types": "dist/index.d.ts",
	"style": "dist/index.css",
	"repository": {
		"type": "git",
		"url": "https://github.com/Bigtablet/bigtablet-design-system.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/index.css",
		"./scss/token": "./dist/styles/token.scss",
		"./vanilla": {
			"style": "./dist/vanilla/bigtablet.min.css",
			"default": "./dist/vanilla/bigtablet.min.js"
		},
		"./vanilla/style.min.css": "./dist/vanilla/bigtablet.min.css",
		"./vanilla/bigtablet.min.js": "./dist/vanilla/bigtablet.min.js"
	},
	"files": [
		"dist",
		"!dist/vanilla/bigtablet.css",
		"!dist/vanilla/bigtablet.js",
		"!dist/vanilla/examples",
		"README.md",
		"LICENSE",
		"docs/AGENT_GUIDE.md"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"build": "tsup && pnpm run copy:scss && pnpm run build:vanilla",
		"build:vanilla": "sh scripts/build-vanilla.sh",
		"copy:scss": "sh scripts/copy-scss.sh",
		"dev": "tsup --watch",
		"storybook": "storybook dev -p 6006",
		"build:sb": "storybook build",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:coverage": "vitest run --project unit --coverage",
		"test:storybook": "vitest run --project storybook",
		"lint:css": "stylelint 'src/ui/**/*.scss' 'src/styles/**/*.scss' 'src/vanilla/**/*.scss'",
		"check:css-vars": "scripts/check-css-vars.sh",
		"check:prose": "scripts/check-prose-headings.sh",
		"check:defaults": "python3 scripts/check-prop-defaults.py",
		"check:geometry": "python3 scripts/check-overlay-geometry.py",
		"size": "size-limit",
		"prepare": "husky"
	},
	"keywords": [
		"design-system",
		"react",
		"storybook",
		"ui",
		"vanilla",
		"thymeleaf",
		"html",
		"css"
	],
	"author": "sangmin",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "pnpm@10.20.0",
	"peerDependencies": {
		"lucide-react": ">=0.552.0",
		"next": ">=15",
		"react": "^19",
		"react-dom": "^19"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/core": "^21.1.0",
		"@size-limit/preset-small-lib": "^12.1.0",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/react": "^10.4.6",
		"@storybook/react-vite": "^10.4.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild-sass-plugin": "^3.7.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lucide-react": "^1.27.0",
		"next": "^16.2.12",
		"playwright": "^1.62.0",
		"postcss-scss": "^4.0.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sass-embedded": "^1.99.0",
		"size-limit": "^12.1.0",
		"storybook": "^10.4.6",
		"stylelint": "^17.14.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "60 kB",
			"message": "Raised 50 kB -> 60 kB on 2026-08-05: baseline was 49.34 kB, leaving 0.66 kB (1.3%) under the old 50 kB limit. The current limit leaves 10.66 kB. Re-measure before raising again."
		},
		{
			"path": "dist/vanilla/bigtablet.min.js",
			"limit": "7 kB",
			"message": "Raised 5 kB -> 7 kB on 2026-08-06: Dropdown multiple/searchable pushed the baseline from 4.13 kB to 5.6 kB, 0.6 kB over the old limit. The current limit leaves 1.4 kB. Re-measure before raising again."
		},
		{
			"path": "dist/index.css",
			"limit": "130 kB"
		}
	],
	"dependencies": {
		"@react-spring/web": "^10.0.3"
	}
}

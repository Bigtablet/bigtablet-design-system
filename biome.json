{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.claude",
			"!**/tsup.config.bundled_*.mjs",
			"!**/*.scss",
			"!**/*.md",
			"!**/*.yaml",
			"!**/*.yml"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "always",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn",
				"noUnusedVariables": "warn",
				"noUnusedFunctionParameters": "warn",
				"useHookAtTopLevel": "error",
				"noComponentHookFactories": "off"
			},
			"style": {
				"noExportedImports": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noArrayIndexKey": "warn",
				"noImplicitAnyLet": "warn"
			},
			"a11y": {
				"useButtonType": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error",
				"noDangerouslySetInnerHtmlWithChildren": "error",
				"noGlobalEval": "error",
				"noBlankTarget": "error"
			},
			"nursery": {
				"noFloatingPromises": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/text/**", "!**/*.test.ts", "!**/*.test.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../**/utils",
											"../**/utils/**",
											"../**/ui",
											"../**/ui/**",
											"../index",
											"../../index"
										],
										"message": "src/text 는 바깥을 쓰지 않습니다 - 따로 떼어 낼 수 있게 src/text 안에서 해결합니다 (#1095)"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noShadowRestrictedNames": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"a11y": {
						"noSvgWithoutTitle": "off",
						"noStaticElementInteractions": "off",
						"useValidAnchor": "off",
						"useSemanticElements": "off"
					},
					"performance": {
						"noImgElement": "off"
					}
				}
			}
		},
		{
			"includes": ["site/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off",
						"noShadowRestrictedNames": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"performance": {
						"noImgElement": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.html"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/vanilla/examples/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedFunctionParameters": "off"
					}
				}
			}
		},
		{
			"includes": ["public/**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	]
}
